# Normalize line endings in the repository regardless of each contributor's
# local core.autocrlf setting. These rules mirror the parent EMAP-SSN
# checkout, so a file moved between the two repositories keeps its endings.
* text=auto

# Python must stay LF, matching the main program.
*.py       text eol=lf

# cmd.exe mis-parses multi-line batch files that use LF, so these stay CRLF.
# opt_vr is Windows-only, so .bat is the only launcher form it ships.
*.bat      text eol=crlf

# Translation catalogs, as in the main program: lupdate writes .ts files
# with LF everywhere, and the compiled .qm files VR Config loads are binary.
src/resources/languages/*.ts  text eol=lf
src/resources/languages/*.qm  binary

# Binary assets: never touch, never diff as text.
*.png   binary
*.ico   binary
*.h5    binary
*.dll   binary
*.exe   binary
